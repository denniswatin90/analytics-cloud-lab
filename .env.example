# Copy to .env (never commit .env). Account identifier looks like ORGNAME-ACCOUNTNAME.
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=DENS
SNOWFLAKE_ROLE=LAB_ENGINEER
SNOWFLAKE_WAREHOUSE=LAB_WH
SNOWFLAKE_DATABASE=MAC_LAB
SNOWFLAKE_SCHEMA=RAW

# Pick ONE auth method (key pair recommended — see tutorials/07):
SNOWFLAKE_PRIVATE_KEY_FILE=/path/to/rsa_key.p8
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
# SNOWFLAKE_PASSWORD=
